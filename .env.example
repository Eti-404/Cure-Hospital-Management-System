# ========================================================
# "নিরাময়" (Niramoy) - Smart Hospital Management System
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to '.env' in both root / backend if needed:
#    cp .env.example .env
# 2. Fill in your project secrets.
# 3. NEVER commit the actual '.env' file to Git!
# ========================================================

# --- SERVER CONFIGURATION ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- JWT AUTHENTICATION CONFIGURATION ---
# Generate a strong 256-bit key in production (e.g., using `openssl rand -hex 32`)
JWT_SECRET=your_jwt_super_secret_key_change_in_production
JWT_EXPIRES_IN=24h

# --- SUPABASE POSTGRESQL CONFIGURATION ---
# Obtain from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# --- FRONTEND (VITE) ENVIRONMENT VARIABLES ---
# Vite variables must be prefixed with VITE_ to be exposed to the client
VITE_API_BASE_URL=http://localhost:5000/api
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

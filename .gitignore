# ========================================================
# Git Ignore Configuration - "নিরাময়" (Niramoy)
# ZERO-LEAK SECURITY MANDATE
# ========================================================

# Dependency directories
node_modules/
jspm_packages/

# Environment files and credentials (CRITICAL: NEVER COMMIT)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# Production build outputs
dist/
build/
out/
.next/

# Logs and debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# IDE and Editor configurations
.vscode/*
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# Testing and coverage
coverage/
.nyc_output/

# Temporary files and cache
.cache/
tmp/
temp/
*.tsbuildinfo
*.oxps
*.xps

